    {
      "name": "Admin Management APIs",
      "item": [
        {
          "name": "Get Dashboard Live Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["admin", "dashboard"] }
          }
        },
        {
          "name": "List Users (Search & Filter)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/users?page=1&limit=10&status=ALL", "host": ["{{baseUrl}}"], "path": ["admin", "users"] }
          }
        },
        {
          "name": "Adjust User Balance (Auditable)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset\": \"ves\",\n  \"type\": \"credit\",\n  \"amount\": 50,\n  \"reason\": \"Evaluation bonus credit\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/users/{{targetUserId}}/adjust-balance", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{targetUserId}}", "adjust-balance"] }
          }
        },
        {
          "name": "Update User Status (Suspend/Restore)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUSPENDED\",\n  \"reason\": \"Suspicious transaction pattern under audit\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/users/{{targetUserId}}/status", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{targetUserId}}", "status"] }
          }
        },
        {
          "name": "Get Audit Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/audit-logs", "host": ["{{baseUrl}}"], "path": ["admin", "audit-logs"] }
          }
        }

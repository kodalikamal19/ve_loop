# ==========================================
# VELoop Rewards — Environment Variables
# ==========================================

# Backend Configuration (backend/.env)
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/veloop_rewards?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
ADMIN_SEED_EMAIL=demo-admin@veloop.io
ADMIN_SEED_PASSWORD=AdminDemo@2026
CLIENT_ORIGIN=https://your-frontend.vercel.app
NODE_ENV=development

# Frontend Configuration (frontend/.env)
# In production, set to your deployed backend URL:
# VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=
